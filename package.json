{
  "name": "personal-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --background",
    "dev:stop": "astro dev stop",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs",
    "validate:data": "node scripts/validate-data.mjs",
    "validate": "npm run validate:data && astro sync",
    "build": "npm run validate && astro build",
    "cv:build": "npm run validate && typst compile --root . src/cv/cv.typ public/files/gabriele_sarti_academic_cv.pdf",
    "cv:watch": "npm run validate && typst watch --root . src/cv/cv.typ public/files/gabriele_sarti_academic_cv.pdf",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.2.8",
    "astro": "^7.0.7",
    "d3-geo": "^3.1.1",
    "katex": "^0.17.0",
    "marked": "^18.0.6",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/topojson-client": "^3.1.5",
    "gray-matter": "^4.0.3",
    "smol-toml": "^1.8.0"
  }
}
