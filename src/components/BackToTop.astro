---
import Icon from './Icon.astro';
---

<button
  class="back-to-top"
  type="button"
  aria-label="Back to top"
  aria-hidden="true"
  tabindex="-1"
  title="Back to top"
  data-back-to-top
>
  <Icon name="arrow-up" size={18} />
</button>

<style>
  .back-to-top {
    position: fixed;
    right: 1.15rem;
    bottom: 4.05rem;
    z-index: 59;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    padding: 0;
    border: 1px solid var(--border-strong);
    color: var(--text-muted);
    background: color-mix(in srgb, var(--bg-solid) 92%, transparent);
    box-shadow: 0 0.35rem 1rem color-mix(in srgb, var(--text) 12%, transparent);
    backdrop-filter: blur(10px);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(0.45rem);
    transition:
      color 120ms ease,
      border-color 120ms ease,
      background 120ms ease,
      opacity 160ms ease,
      transform 160ms ease,
      visibility 160ms;
  }

  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .back-to-top:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  @media (max-width: 1080px) {
    .back-to-top {
      bottom: 1.15rem;
    }
  }

  @media (max-width: calc(80rem - 0.02px)) {
    :global(body.has-prose-layout) .back-to-top {
      bottom: 4.05rem;
    }
  }

  @media (min-width: 1081px) and (max-width: calc(80rem - 0.02px)) {
    :global(body.has-prose-layout) .back-to-top {
      bottom: 6.95rem;
    }
  }
</style>

<script>
  const backToTop = document.querySelector<HTMLButtonElement>('[data-back-to-top]');

  if (backToTop) {
    const updateVisibility = () => {
      const isVisible = window.scrollY > Math.max(320, window.innerHeight * 0.5);
      backToTop.classList.toggle('is-visible', isVisible);
      backToTop.setAttribute('aria-hidden', String(!isVisible));
      backToTop.tabIndex = isVisible ? 0 : -1;
    };

    backToTop.addEventListener('click', () => {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
    });

    window.addEventListener('scroll', updateVisibility, { passive: true });
    updateVisibility();
  }
</script>
