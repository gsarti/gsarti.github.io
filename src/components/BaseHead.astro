---
import { getCollection, getEntry } from 'astro:content';
import '@fontsource-variable/inter';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Emit schema.org Person JSON-LD (only on the homepage). */
  person?: boolean;
}

const profile = await getEntry('profile', 'main');
if (!profile) throw new Error('profile.yaml missing');
const positions = await getCollection('positions');
const currentPositionEntry = positions.find(
  (position) => position.id === profile.data.currentPositionId
);
if (!currentPositionEntry) {
  throw new Error(`Current position "${profile.data.currentPositionId}" missing from positions.yaml`);
}
const currentPosition = currentPositionEntry.data;
const role = currentPosition.homepagePresentation?.role ?? currentPosition.title;
const site = {
  title: profile.data.name,
  author: profile.data.name,
  url: profile.data.website,
  description: `${role} at ${currentPosition.organization}.`,
};
const { title, description = site.description, image = '/img/avatar.jpg', person = false } = Astro.props;

const pageTitle = title ? `${title} · ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.author,
  url: site.url,
  jobTitle: currentPosition.title,
  worksFor: {
    '@type': 'Organization',
    name: currentPosition.organization,
    url: currentPosition.organizationUrl,
  },
  sameAs: profile.data.socials.filter((s) => s.url.startsWith('http')).map((s) => s.url),
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={site.author} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/png" sizes="32x32" href="/img/icon-32.png?v=2" />
<link rel="icon" type="image/png" sizes="192x192" href="/img/icon-192.png?v=2" />
<link rel="apple-touch-icon" sizes="192x192" href="/img/icon-192.png?v=2" />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.title} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{person && <script type="application/ld+json" set:html={JSON.stringify(personLd)} />}

<script is:inline>
  // Pre-paint theme init: avoids a flash of the wrong theme.
  (() => {
    const stored = localStorage.getItem('theme');
    const system = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    document.documentElement.dataset.theme = stored === 'dark' || stored === 'light' ? stored : system;
  })();
</script>
