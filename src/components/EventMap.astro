    }

    .map-tooltip-item small {
      font-size: 0.74rem;
    }
  }

  @media (max-width: 350px) {
    .map-year-tick:nth-child(even) b {
      display: none;
    }
  }
</style>

<script>
  const initializeEventMaps = () => {
    document.querySelectorAll<HTMLElement>('[data-event-map]:not([data-map-ready])').forEach((map) => {
      map.dataset.mapReady = 'true';
      const canvas = map.querySelector<HTMLElement>('.map-canvas');
      const viewport = map.querySelector<HTMLElement>('[data-map-viewport]');
      const stage = map.querySelector<HTMLElement>('[data-map-stage]');
      const worldMap = map.querySelector<SVGSVGElement>('.world-map');
      const tooltip = map.querySelector<HTMLElement>('.map-tooltip');
      const zoomIn = map.querySelector<HTMLButtonElement>('[data-map-zoom-in]');
      const zoomOut = map.querySelector<HTMLButtonElement>('[data-map-zoom-out]');
      const reset = map.querySelector<HTMLButtonElement>('[data-map-reset]');
      const zoomStatus = map.querySelector<HTMLElement>('[data-map-zoom-status]');
      const filterButtons = Array.from(map.querySelectorAll<HTMLButtonElement>('[data-map-filter]'));
      const timeline = map.querySelector<HTMLElement>('[data-map-timeline]');
      const rangeStart = map.querySelector<HTMLInputElement>('[data-map-range-start]');
      const rangeEnd = map.querySelector<HTMLInputElement>('[data-map-range-end]');
      const timelineOutput = map.querySelector<HTMLOutputElement>('[data-map-timeline-output]');
      const points = Array.from(map.querySelectorAll<HTMLButtonElement>('.map-point'));
      if (!canvas || !viewport || !stage || !worldMap || !tooltip || !zoomIn || !zoomOut || !reset || !timeline || !rangeStart || !rangeEnd || !timelineOutput) return;

      type MapKind = 'talk' | 'event' | 'position';
      const isMapKind = (kind: string | undefined): kind is MapKind =>
        kind === 'talk' || kind === 'event' || kind === 'position';
      const pointClass = (talkCount: number, eventCount: number, positionCount: number) => {
        if (talkCount > 0 && eventCount > 0 && positionCount > 0) return 'map-point--all';
        if (talkCount > 0 && eventCount > 0) return 'map-point--talk-event';
        if (talkCount > 0 && positionCount > 0) return 'map-point--talk-position';
        if (eventCount > 0 && positionCount > 0) return 'map-point--event-position';
        if (talkCount > 0) return 'map-point--talk';
        if (eventCount > 0) return 'map-point--event';
        return 'map-point--position';
      };
      const visibleSummary = (talkCount: number, eventCount: number, positionCount: number, titleCase = false) => [
        talkCount > 0 ? `${talkCount} ${talkCount === 1 ? (titleCase ? 'Talk' : 'talk') : (titleCase ? 'Talks' : 'talks')}` : '',
        eventCount > 0 ? `${eventCount} ${eventCount === 1 ? (titleCase ? 'Event' : 'event') : (titleCase ? 'Events' : 'events')}` : '',
        positionCount > 0 ? `${positionCount} ${positionCount === 1 ? (titleCase ? 'Position' : 'position') : (titleCase ? 'Positions' : 'positions')}` : '',
      ].filter(Boolean).join(titleCase ? ' · ' : ', ');
      let pinnedPoint: HTMLButtonElement | null = null;
      let suppressNextPointFocus = false;
      const activeKinds: Record<MapKind, boolean> = { talk: true, event: true, position: true };
      const timelineMin = Number(timeline.dataset.mapTimelineMin);
      const timelineMax = Number(timeline.dataset.mapTimelineMax);
      let selectedStart = timelineMin;
      let selectedEnd = timelineMax;
      const timelineFormatter = new Intl.DateTimeFormat('en-GB', { month: 'short', year: 'numeric' });
      const mapWidth = Number(viewport.dataset.mapWidth);
      const mapHeight = Number(viewport.dataset.mapHeight);
      const zoomLevels = [1, 1.5, 2, 3, 4, 6, 8, 10, 12];
      let zoomIndex = 0;
      let scale = zoomLevels[zoomIndex];
      let viewX = 0;
      let viewY = 0;
      let dragPointer: number | null = null;
      let dragX = 0;
      let dragY = 0;
      let dragViewX = 0;
      let dragViewY = 0;
      let mobileSheetExpanded = false;
      let sheetSwipeStart: { pointerId: number; x: number; y: number } | null = null;
      const mobileSheetQuery = window.matchMedia('(max-width: 560px)');

      const formatTimelineDate = (monthIndex: number) => timelineFormatter.format(
        new Date(Math.floor(monthIndex / 12), monthIndex % 12, 1)
      );

      const getPointTemplate = (point: HTMLButtonElement) => {
        const templateId = point.dataset.mapTemplate;
        return templateId ? map.querySelector<HTMLTemplateElement>(`#${templateId}`) : null;
      };

      const getVisibleCounts = (point: HTMLButtonElement) => {
        const counts = { talk: 0, event: 0, position: 0 };
        const template = getPointTemplate(point);
        if (!template) return counts;

        template.content.querySelectorAll<HTMLElement>('[data-map-kind]').forEach((item) => {
          const kind = item.dataset.mapKind;
          const dateStartIndex = Number(item.dataset.mapDateStartIndex);
          const dateEndIndex = Number(item.dataset.mapDateEndIndex);
          if (
            isMapKind(kind) &&
            activeKinds[kind] &&
            dateEndIndex >= selectedStart &&
            dateStartIndex <= selectedEnd
          ) {
            counts[kind] += 1;
          }
        });
        return counts;
      };

      const positionTooltip = (point: HTMLButtonElement) => {
        const canvasRect = canvas.getBoundingClientRect();
        const pointRect = point.getBoundingClientRect();
        const rawX = pointRect.left - canvasRect.left + pointRect.width / 2;
        const rawY = pointRect.top - canvasRect.top + pointRect.height / 2;
        tooltip.style.left = `${rawX}px`;
        tooltip.style.top = `${rawY}px`;

        requestAnimationFrame(() => {
          const tooltipRect = tooltip.getBoundingClientRect();
          const halfWidth = tooltipRect.width / 2;
          const clampedX = Math.max(
            halfWidth + 8,
            Math.min(canvas.clientWidth - halfWidth - 8, rawX)
          );
          tooltip.style.left = `${clampedX}px`;
          tooltip.style.transform =
            rawY - tooltipRect.height - 12 < 0
              ? 'translate(-50%, 0.65rem)'
              : 'translate(-50%, calc(-100% - 0.55rem))';
        });
      };

      const renderMobileSheet = (expanded = mobileSheetExpanded) => {
        const itemCount = tooltip.querySelectorAll('[data-map-kind]').length;
        const previewCount = window.innerHeight <= 680 ? 1 : 2;
        const canExpand = mobileSheetQuery.matches && itemCount > previewCount;
        const toggle = tooltip.querySelector<HTMLButtonElement>('[data-map-tooltip-toggle]');
        const label = tooltip.querySelector<HTMLElement>('[data-map-tooltip-toggle-label]');

        mobileSheetExpanded = canExpand && expanded;
        tooltip.dataset.mapPreviewCount = String(previewCount);
        tooltip.classList.toggle('is-compact', canExpand && !mobileSheetExpanded);
        tooltip.classList.toggle('is-expanded', mobileSheetExpanded);

        if (!toggle) return;
        toggle.hidden = !canExpand;
        toggle.setAttribute('aria-expanded', String(mobileSheetExpanded));
        if (label) {
          label.textContent = mobileSheetExpanded
            ? `Show latest ${previewCount === 1 ? 'entry' : `${previewCount} entries`}`
            : `Show all ${itemCount} entries`;
        }
      };

      const showTooltip = (point: HTMLButtonElement) => {
        const template = getPointTemplate(point);
        if (!template) return;

        tooltip.replaceChildren(template.content.cloneNode(true));
        tooltip.querySelectorAll<HTMLElement>('[data-map-kind]').forEach((item) => {
          const kind = item.dataset.mapKind;
          const dateStartIndex = Number(item.dataset.mapDateStartIndex);
          const dateEndIndex = Number(item.dataset.mapDateEndIndex);
          if (
            isMapKind(kind) &&
            (!activeKinds[kind] || dateEndIndex < selectedStart || dateStartIndex > selectedEnd)
          ) {
            item.remove();
          }
        });

        const { talk: talkCount, event: eventCount, position: positionCount } = getVisibleCounts(point);
        if (talkCount + eventCount + positionCount === 0) {
          hideTooltip();
          return;
        }
        const summary = visibleSummary(talkCount, eventCount, positionCount, true);
        const summaryElement = tooltip.querySelector<HTMLElement>('[data-map-tooltip-summary]');
        if (summaryElement) summaryElement.textContent = summary;

        mobileSheetExpanded = false;
        renderMobileSheet(false);

        const closeButton = tooltip.querySelector<HTMLButtonElement>('[data-map-tooltip-close]');
        closeButton?.addEventListener('click', () => {
          const pointToFocus = pinnedPoint;
          suppressNextPointFocus = Boolean(pointToFocus);
          unpinPoint();
          hideTooltip();
          pointToFocus?.focus();
        });

        tooltip.hidden = false;
        positionTooltip(point);
      };

      const hideTooltip = () => {
        tooltip.hidden = true;
      };

      const unpinPoint = () => {
        if (!pinnedPoint) return;
        pinnedPoint.classList.remove('is-pinned');
        pinnedPoint.setAttribute('aria-expanded', 'false');
        pinnedPoint = null;
      };

      const clampView = () => {
        const viewWidth = mapWidth / scale;
        const viewHeight = mapHeight / scale;
        viewX = Math.min(mapWidth - viewWidth, Math.max(0, viewX));
        viewY = Math.min(mapHeight - viewHeight, Math.max(0, viewY));
      };

      const renderTimeline = () => {
        const timelineSpan = Math.max(1, timelineMax - timelineMin);
        const startPercent = ((selectedStart - timelineMin) / timelineSpan) * 100;
        const endPercent = ((selectedEnd - timelineMin) / timelineSpan) * 100;
        timeline.style.setProperty('--timeline-start', `${startPercent}%`);
        timeline.style.setProperty('--timeline-end', `${endPercent}%`);
        const startLabel = formatTimelineDate(selectedStart);
        const endLabel = formatTimelineDate(selectedEnd);
        timelineOutput.textContent = `${startLabel} – ${endLabel}`;
        rangeStart.setAttribute('aria-valuetext', startLabel);
        rangeEnd.setAttribute('aria-valuetext', endLabel);
      };

      const renderMapView = () => {
        clampView();
        const viewWidth = mapWidth / scale;
        const viewHeight = mapHeight / scale;
        worldMap.setAttribute('viewBox', `${viewX} ${viewY} ${viewWidth} ${viewHeight}`);
        stage.dataset.mapScale = String(scale);
        stage.dataset.mapViewBox = `${viewX},${viewY},${viewWidth},${viewHeight}`;
        points.forEach((point) => {
          const { talk: talkCount, event: eventCount, position: positionCount } = getVisibleCounts(point);
          const visibleCount = talkCount + eventCount + positionCount;
          if (point.dataset.mapFixed === 'true') {
            point.hidden = visibleCount === 0;
          } else {
            const pointX = Number(point.dataset.mapX);
            const pointY = Number(point.dataset.mapY);
            const relativeX = (pointX - viewX) / viewWidth;
            const relativeY = (pointY - viewY) / viewHeight;
            point.style.left = `${relativeX * 100}%`;
            point.style.top = `${relativeY * 100}%`;
            point.hidden = visibleCount === 0 || relativeX < -0.02 || relativeX > 1.02 || relativeY < -0.04 || relativeY > 1.04;
          }
          point.classList.remove(
            'map-point--talk',
            'map-point--event',
            'map-point--position',
            'map-point--talk-event',
            'map-point--talk-position',
            'map-point--event-position',
            'map-point--all'
          );
          point.classList.add(pointClass(talkCount, eventCount, positionCount));
          const summary = visibleSummary(talkCount, eventCount, positionCount);
          point.setAttribute(
            'aria-label',
            `${point.dataset.mapLocation}: ${visibleCount} ${visibleCount === 1 ? 'entry' : 'entries'} (${summary})`
          );
        });
        viewport.classList.toggle('is-zoomed', scale > 1);
        zoomOut.disabled = zoomIndex === 0;
        reset.disabled = zoomIndex === 0;
        zoomIn.disabled = zoomIndex === zoomLevels.length - 1;
        if (zoomStatus) zoomStatus.textContent = `Map zoom ${scale}×`;
        if (pinnedPoint?.hidden) {
          unpinPoint();
          hideTooltip();
        }
        const pointToReposition = pinnedPoint;
        if (pointToReposition) {
          requestAnimationFrame(() => {
            if (pointToReposition.isConnected) positionTooltip(pointToReposition);
          });
        }
      };

      const setZoomIndex = (nextIndex: number, focusX = viewport.clientWidth / 2, focusY = viewport.clientHeight / 2) => {
        const boundedIndex = Math.max(0, Math.min(zoomLevels.length - 1, nextIndex));
        if (boundedIndex === zoomIndex) return;
        const focusRatioX = viewport.clientWidth > 0 ? focusX / viewport.clientWidth : 0.5;
        const focusRatioY = viewport.clientHeight > 0 ? focusY / viewport.clientHeight : 0.5;
        const focusMapX = viewX + focusRatioX * (mapWidth / scale);
        const focusMapY = viewY + focusRatioY * (mapHeight / scale);
        const nextScale = zoomLevels[boundedIndex];
        zoomIndex = boundedIndex;
        scale = nextScale;
        viewX = focusMapX - focusRatioX * (mapWidth / scale);
        viewY = focusMapY - focusRatioY * (mapHeight / scale);
        renderMapView();
      };

      zoomIn.addEventListener('click', () => setZoomIndex(zoomIndex + 1));
      zoomOut.addEventListener('click', () => setZoomIndex(zoomIndex - 1));
      reset.addEventListener('click', () => {
        zoomIndex = 0;
        scale = zoomLevels[0];
        viewX = 0;
        viewY = 0;
        renderMapView();
      });

      filterButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const kind = button.dataset.mapFilter;
          if (!isMapKind(kind)) return;
          activeKinds[kind] = !activeKinds[kind];
          button.setAttribute('aria-pressed', String(activeKinds[kind]));
          renderMapView();
          if (pinnedPoint && !pinnedPoint.hidden) showTooltip(pinnedPoint);
        });
      });

      const updateTimeline = (changedRange: 'start' | 'end') => {
        const nextStart = Number(rangeStart.value);
        const nextEnd = Number(rangeEnd.value);
        if (changedRange === 'start') {
          selectedStart = Math.min(nextStart, selectedEnd);
          rangeStart.value = String(selectedStart);
        } else {
          selectedEnd = Math.max(nextEnd, selectedStart);
          rangeEnd.value = String(selectedEnd);
        }
        renderTimeline();
        renderMapView();
        if (pinnedPoint && !pinnedPoint.hidden) showTooltip(pinnedPoint);
      };

      rangeStart.addEventListener('input', () => updateTimeline('start'));
      rangeEnd.addEventListener('input', () => updateTimeline('end'));

      tooltip.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element) || !target.closest('[data-map-tooltip-toggle]')) return;
        renderMobileSheet(!mobileSheetExpanded);
      });

      tooltip.addEventListener('pointerdown', (event) => {
        if (!mobileSheetQuery.matches) return;
        sheetSwipeStart = {
          pointerId: event.pointerId,
          x: event.clientX,
          y: event.clientY,
        };
        if (!mobileSheetExpanded) tooltip.setPointerCapture(event.pointerId);
      });

      tooltip.addEventListener('pointerup', (event) => {
        if (!sheetSwipeStart || event.pointerId !== sheetSwipeStart.pointerId) return;
        const deltaX = event.clientX - sheetSwipeStart.x;
        const deltaY = event.clientY - sheetSwipeStart.y;
        sheetSwipeStart = null;
        if (tooltip.hasPointerCapture(event.pointerId)) tooltip.releasePointerCapture(event.pointerId);
        if (Math.abs(deltaY) < 48 || Math.abs(deltaY) <= Math.abs(deltaX) * 1.25) return;

        if (deltaY < 0 && !mobileSheetExpanded) {
          renderMobileSheet(true);
          return;
        }

        const list = tooltip.querySelector<HTMLElement>('.map-tooltip-list');
        if (deltaY > 0 && mobileSheetExpanded && (!list || list.scrollTop <= 0)) {
          renderMobileSheet(false);
        }
      });

      tooltip.addEventListener('pointercancel', () => {
        sheetSwipeStart = null;
      });

      viewport.addEventListener('wheel', (event) => {
        if (!event.ctrlKey && !event.metaKey) return;
        event.preventDefault();
        const rect = viewport.getBoundingClientRect();
        setZoomIndex(
          zoomIndex + (event.deltaY < 0 ? 1 : -1),
          event.clientX - rect.left,
          event.clientY - rect.top
        );
      }, { passive: false });

      viewport.addEventListener('pointerdown', (event) => {
        const target = event.target;
        if (scale === 1 || !(target instanceof Element) || target.closest('.map-point')) return;
        dragPointer = event.pointerId;
        dragX = event.clientX;
        dragY = event.clientY;
        dragViewX = viewX;
        dragViewY = viewY;
        viewport.classList.add('is-dragging');
        viewport.setPointerCapture(event.pointerId);
      });

      viewport.addEventListener('pointermove', (event) => {
        if (dragPointer !== event.pointerId) return;
        viewX = dragViewX - ((event.clientX - dragX) / viewport.clientWidth) * (mapWidth / scale);
        viewY = dragViewY - ((event.clientY - dragY) / viewport.clientHeight) * (mapHeight / scale);
        renderMapView();
      });

      const finishDragging = (event: PointerEvent) => {
        if (dragPointer !== event.pointerId) return;
        dragPointer = null;
        viewport.classList.remove('is-dragging');
        if (viewport.hasPointerCapture(event.pointerId)) viewport.releasePointerCapture(event.pointerId);
      };

      viewport.addEventListener('pointerup', finishDragging);
      viewport.addEventListener('pointercancel', finishDragging);

      new ResizeObserver(() => {
        renderMapView();
        if (!tooltip.hidden) renderMobileSheet(mobileSheetExpanded);
      }).observe(viewport);
      window.addEventListener('resize', () => {
        if (!tooltip.hidden) renderMobileSheet(mobileSheetExpanded);
      });
      renderTimeline();
      renderMapView();

      points.forEach((point) => {
        point.addEventListener('mouseenter', () => {
          if (!pinnedPoint || pinnedPoint === point) showTooltip(point);
        });
        point.addEventListener('focus', () => {
          if (suppressNextPointFocus) {
            suppressNextPointFocus = false;
            return;
          }
          if (!pinnedPoint || pinnedPoint === point) showTooltip(point);
        });
        point.addEventListener('mouseleave', () => {
          if (!pinnedPoint) hideTooltip();
        });
        point.addEventListener('blur', () => {
          if (!pinnedPoint) hideTooltip();
        });
        point.addEventListener('click', () => {
          if (pinnedPoint === point) {
            unpinPoint();
            hideTooltip();
            return;
          }

          unpinPoint();
          pinnedPoint = point;
          point.classList.add('is-pinned');
          point.setAttribute('aria-expanded', 'true');
          showTooltip(point);
        });
        point.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape' || !pinnedPoint) return;
          unpinPoint();
          hideTooltip();
        });
      });

      document.addEventListener('click', (event) => {
        if (!pinnedPoint) return;
        const target = event.target;
        if (!(target instanceof Node)) return;
        if (pinnedPoint.contains(target) || tooltip.contains(target)) return;
        unpinPoint();
        hideTooltip();
      });
    });
  };

  initializeEventMaps();
  document.addEventListener('astro:page-load', initializeEventMaps);
</script>
