---
import { getEntry } from 'astro:content';
import { NAV } from '../config/site';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';

const profile = await getEntry('profile', 'main');
if (!profile) throw new Error('profile.yaml missing');
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href?: string) =>
  href && href.startsWith('/') && (path === href || path.startsWith(href + '/'));
---

<header class="site-header rule-below">
  <div class="container container--wide inner">
    <a class="brand" href="/" aria-label={`${profile.data.name}, home`}>
      <strong>{profile.data.name}</strong>
    </a>

    <nav aria-label="Main">
      <button id="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu" aria-label="Menu">
        <span class="open"><Icon name="menu" size={20} /></span>
        <span class="closed"><Icon name="close" size={20} /></span>
      </button>

      <ul id="nav-menu">
        {
          NAV.map((item) =>
            item.children ? (
              <li class="has-dropdown">
                <details>
                  <summary>{item.label}</summary>
                  <ul class="dropdown">
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          target={child.external ? '_blank' : undefined}
                          rel={child.external ? 'noopener' : undefined}
                          aria-current={isActive(child.href) ? 'page' : undefined}
                        >
                          {child.label}
                          {child.external && <Icon name="external" size={12} />}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener' : undefined}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                  {item.external && <Icon name="external" size={12} />}
                </a>
              </li>
            )
          )
        }
        <li class="toggle-slot"><ThemeToggle /></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(14px);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.65rem;
  }

  .brand {
    position: relative;
    display: inline-flex;
    padding-block: 0.25rem;
    color: var(--text);
    white-space: nowrap;
  }

  .brand::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 220ms ease;
  }

  .brand:hover {
    text-decoration: none;
  }

  .brand:hover::after,
  .brand:focus-visible::after {
    transform: scaleX(1);
  }

  .brand strong {
    font-family: var(--font-sans);
    font-size: 1.28rem;
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: 0;
    list-style: none;
    padding: 0;
  }

  nav a,
  nav summary {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.42rem;
    font: 560 0.92rem/1 var(--font-sans);
    letter-spacing: -0.01em;
    color: var(--text-muted);
    cursor: pointer;
    white-space: nowrap;
    transition: color 120ms ease, background 120ms ease;
  }

  nav a:hover,
  nav summary:hover {
    color: var(--accent);
    background: var(--accent-subtle);
    text-decoration: none;
  }

  nav a[aria-current='page'] {
    color: var(--accent);
    box-shadow: inset 0 -2px var(--accent);
  }

  /* Dropdowns */
  .has-dropdown details {
    position: relative;
  }

  .has-dropdown summary {
    list-style: none;
  }

  .has-dropdown summary::-webkit-details-marker {
    display: none;
  }

  .has-dropdown summary::after {
    content: '';
    border: 4px solid transparent;
    border-top-color: currentColor;
    margin-top: 4px;
  }

  .dropdown {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    flex-direction: column;
    align-items: stretch;
    min-width: 12.5rem;
    background: var(--bg-solid);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    padding: 0.35rem;
    z-index: 20;
  }

  .dropdown a {
    width: 100%;
    justify-content: space-between;
  }

  /* Mobile */
  #nav-toggle {
    display: none;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-muted);
    border-radius: 0;
    width: 2.2rem;
    height: 2.2rem;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  #nav-toggle .closed {
    display: none;
  }

  #nav-toggle[aria-expanded='true'] .open {
    display: none;
  }

  #nav-toggle[aria-expanded='true'] .closed {
    display: inline-flex;
  }

  @media (max-width: 860px) {
    #nav-toggle {
      display: inline-flex;
    }

    nav ul#nav-menu {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      background: var(--bg-solid);
      border-bottom: 1px solid var(--border);
      border-top: 1px solid var(--border);
      padding: 0.75rem var(--pad-inline) 1rem;
      z-index: 30;
    }

    nav ul#nav-menu.open {
      display: flex;
    }

    .site-header {
      position: relative;
    }

    nav a,
    nav summary {
      padding: 0.55rem 0.6rem;
      font-size: 0.95rem;
    }

    .dropdown {
      position: static;
      box-shadow: none;
      border: none;
      padding-left: 1rem;
    }

    .toggle-slot {
      margin-top: 0.5rem;
    }
  }

</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(Boolean(open)));
  });

  // Close any open dropdown when clicking elsewhere or opening another one.
  document.addEventListener('click', (e) => {
    document.querySelectorAll('.has-dropdown details[open]').forEach((d) => {
      if (e.target instanceof Node && !d.contains(e.target)) d.removeAttribute('open');
    });
  });
</script>
