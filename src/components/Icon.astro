---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
  set:html={(title ? `<title>${title}</title>` : '') + icon.body}
  {...icon.fill
    ? { fill: 'currentColor' }
    : {
        fill: 'none',
        stroke: 'currentColor',
        'stroke-width': '2',
        'stroke-linecap': 'round',
        'stroke-linejoin': 'round',
      }}
/>

<style>
  .icon {
    flex-shrink: 0;
    vertical-align: -0.15em;
  }
</style>
