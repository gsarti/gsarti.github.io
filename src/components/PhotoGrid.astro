---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { marked } from 'marked';

export interface PhotoGridItem {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  objectPosition?: string;
}

interface Props {
  photos: PhotoGridItem[];
  label?: string;
  aspectRatio?: string;
  singleWidth?: number;
}

const {
  photos,
  label = 'Photo gallery',
  aspectRatio = '4 / 3',
  singleWidth = 70,
} = Astro.props;

const normalizedSingleWidth = Math.min(100, Math.max(1, singleWidth));
---

<div
  class:list={['photo-grid', { 'photo-grid--single': photos.length === 1 }]}
  role="group"
  aria-label={label}
  style={`--photo-grid-ratio: ${aspectRatio}; --photo-grid-single-width: ${normalizedSingleWidth}%`}
>
  {
    photos.map((photo) => (
      <figure class="photo-grid__item">
        <div class="photo-grid__frame">
          <Image
            class="photo-grid__image"
            src={photo.src}
            alt={photo.alt}
            width={960}
            loading="lazy"
            style={photo.objectPosition ? `object-position: ${photo.objectPosition}` : undefined}
          />
        </div>
        {photo.caption && <figcaption set:html={marked.parseInline(photo.caption)} />}
      </figure>
    ))
  }
</div>

<style>
  .photo-grid {
    --photo-grid-gap: clamp(0.9rem, 2vw, 1.4rem);

    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--photo-grid-gap);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .photo-grid__item {
    min-width: 0;
    margin: 0;
  }

  .photo-grid__item:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    width: calc(50% - var(--photo-grid-gap) / 2);
    justify-self: center;
  }

  .photo-grid--single {
    width: var(--photo-grid-single-width);
    grid-template-columns: minmax(0, 1fr);
    margin-inline: auto;
  }

  .photo-grid--single .photo-grid__item:last-child:nth-child(odd) {
    grid-column: auto;
    width: 100%;
  }

  .photo-grid__frame {
    aspect-ratio: var(--photo-grid-ratio);
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-raised);
  }

  .photo-grid__image {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    border-radius: 0;
    object-fit: cover;
  }

  figcaption {
    margin-top: 0.55rem;
    color: var(--text-muted);
    font: 500 0.83rem/1.4 var(--font-sans);
    text-align: left;
  }

  @media (max-width: 620px) {
    .photo-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.35rem;
    }

    .photo-grid__item:last-child:nth-child(odd) {
      grid-column: auto;
      width: 100%;
    }

    .photo-grid--single {
      width: 100%;
    }
  }
</style>
