---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const slugOf = (id: string) => id.replace(/\/index$/, '');
---

<BaseLayout title="Remit not Paucity" description="A blog to trace impunity, for those that mutter in opacity">
  <div class="page">
    <header class="page-head">
      <h1>
        Remit not Paucity<a
          class="title-note-ref"
          href="#blog-title-note"
          id="blog-title-note-ref"
          role="doc-noteref"
          aria-label="Footnote 1"
        >1</a>
      </h1>
      <p class="subtitle">
        A blog <span class="subtitle-accent">to trace impunity</span> and{' '}
        <span class="subtitle-signal">mutter in opacity</span>.
      </p>
    </header>
    <div class="posts">
      {
        posts.map((post) => (
          <a class="post-row" href={`/blog/${slugOf(post.id)}`}>
            <p class="date">
              <FormattedDate date={post.data.date} />
            </p>
            <div class="body">
              <h2>{post.data.title}</h2>
              {post.data.summary && <p class="summary">{post.data.summary}</p>}
            </div>
          </a>
        ))
      }
    </div>
    <p class="title-note" id="blog-title-note" role="doc-footnote">
      <a class="title-note-backref" href="#blog-title-note-ref">1.</a>
      The blog name is a hat tip to <a href="https://www.gregegan.net/">Greg Egan</a>'s <a href="https://en.wikipedia.org/wiki/Permutation_City" target="_blank" rel="noopener noreferrer">Permutation City</a>, a great sci-fi novel exploring the nature of consciousness and reality. Remit not paucity is a timely admonition: in the intelligence age where possibilities seem endless, it's good to remember that constraints breed innovation. "Remit not paucity" is also a nice anagram of the novel's title. I came up with two more anagrams that fit well the "LLMs interpretability and auditing" theme, so I added them in the subtitle.
    </p>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: 2.75rem 4rem;
  }

  .page-head {
    margin-bottom: 1.75rem;
  }

  .page-head h1 {
    margin-top: 0.3rem;
  }

  .title-note-ref {
    display: inline-block;
    margin-left: 0.3em;
    margin-top: -0.3em;
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 0.27em;
    font-weight: 650;
    line-height: 1;
    vertical-align: super;
  }

  .title-note-ref:hover,
  .title-note-ref:focus-visible,
  .title-note-backref:hover,
  .title-note-backref:focus-visible {
    color: var(--accent-hover);
    text-decoration: none;
  }

  .subtitle {
    max-width: 45rem;
    margin-top: 0.75rem;
    color: var(--text-muted);
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 0.98rem + 0.45vw, 1.4rem);
    line-height: 1.45;
  }

  .subtitle .subtitle-accent {
    color: var(--accent);
  }

  .subtitle .subtitle-signal {
    color: var(--signal);
  }

  .title-note {
    width: 100%;
    margin-top: 2rem;
    padding-block: 0.9rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .title-note-backref {
    margin-right: 0.28rem;
    color: var(--accent);
    font-weight: 600;
  }

  .posts {
    border-top: 1px solid var(--border);
  }

  .post-row {
    display: grid;
    grid-template-columns: clamp(7.5rem, 12vw, 10rem) minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: start;
    padding-block: 1.35rem;
    border-bottom: 1px solid var(--border);
    color: inherit;
    transition: color 160ms ease;
  }

  .post-row:hover,
  .post-row:focus-visible {
    text-decoration: none;
  }

  .post-row:hover h2,
  .post-row:focus-visible h2 {
    color: var(--accent);
  }

  .date {
    margin-top: 0.12rem;
    color: var(--text-muted);
    font-family: var(--font-display);
    font-size: 0.95rem;
    line-height: 1.45;
    white-space: nowrap;
  }

  h2 {
    margin: 0 0 0.35rem;
    font-size: clamp(1.12rem, 1.03rem + 0.3vw, 1.3rem);
    line-height: 1.3;
    transition: color 160ms ease;
  }

  .summary {
    max-width: 55rem;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  @media (max-width: 640px) {
    .post-row {
      grid-template-columns: 1fr;
      gap: 0.35rem;
      padding-block: 1.15rem;
    }

    .date {
      margin-top: 0;
      font-size: 0.88rem;
    }
  }
</style>
