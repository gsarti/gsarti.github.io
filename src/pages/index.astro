---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { marked } from 'marked';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import SocialLinks from '../components/SocialLinks.astro';
import LandingNews from '../components/LandingNews.astro';
import PublicationCard from '../components/PublicationCard.astro';
import PhDBookShowcase from '../components/PhDBookShowcase.astro';
import Icon from '../components/Icon.astro';
import OrgLogo from '../components/OrgLogo.astro';
import avatar from '../assets/avatar.jpg';

const profile = await getEntry('profile', 'main');
if (!profile) throw new Error('profile.yaml missing');
const p = profile.data;

const news = await getCollection('news');
const positionEntries = await getCollection('positions');
const educationEntries = await getCollection('education');

const publications = await getCollection('publications');
const publicationsById = new Map(publications.map((publication) => [publication.id, publication]));
const selectedPubs = publications
  .filter((publication) => publication.data.featuredOrder !== undefined)
  .sort((a, b) => (a.data.featuredOrder ?? 0) - (b.data.featuredOrder ?? 0));
const currentPositionEntry = positionEntries.find((position) => position.id === p.currentPositionId);
if (!currentPositionEntry) {
  throw new Error(`Current position "${p.currentPositionId}" missing from positions.yaml`);
}
const currentPosition = currentPositionEntry.data;
const hero = currentPosition.homepagePresentation;
if (!hero) throw new Error(`Homepage presentation missing for position "${p.currentPositionId}"`);
const scholarUrl = p.socials.find((social) => social.icon === 'scholar')?.url;
if (!scholarUrl) throw new Error('Google Scholar social link missing from profile.yaml');
const homepagePositions = positionEntries
  .filter((position) => position.data.homepage)
  .sort(
    (a, b) =>
      b.data.dateStart.getTime() - a.data.dateStart.getTime() ||
      b.data.dateEnd.getTime() - a.data.dateEnd.getTime()
  )
  .map((position) => position.data);
const homepageEducation = educationEntries
  .filter((education) => education.data.homepage)
  .map((education) => education.data);

const yearRange = (start: Date, end: Date, ongoing = false) => {
  const first = start.getUTCFullYear();
  if (ongoing) return `${first} - Ongoing`;
  const last = end.getUTCFullYear();
  return first === last ? String(first) : `${first} - ${last}`;
};
---

<BaseLayout person>
  <section class="hero">
    <div class="hero-main">
      <div class="identity">
        <div class="portrait-frame">
          <Image class="avatar" src={avatar} alt={`Portrait of ${p.name}`} width={520} loading="eager" />
        </div>
        <div class="identity-copy">
          <h1>{p.name}</h1>
          <p class="role">{hero.role}</p>
          <p class="affiliation">
            <a href={hero.labUrl} target="_blank" rel="noopener">
              <span class="affiliation-primary">{hero.lab}, {hero.department}</span>
              <span class="affiliation-university">{currentPosition.organization}</span>
            </a>
          </p>
        </div>
        <div class="social-row">
          <SocialLinks />
        </div>
      </div>

      <div class="hero-copy">
        <div class="bio prose-inline" set:html={marked.parse(p.bio)} />
      </div>
    </div>

    <div class="profile-grid">
      <article class="profile-col interests-col">
        <h2>Research interests</h2>
        <ul class="focus-list">
          {
            p.interests.map((interest) => (
              <li>
                <span class="focus-icon"><Icon name={interest.icon} size={16} /></span>
                <span>{interest.name}</span>
              </li>
            ))
          }
        </ul>
      </article>
      <article class="career-col">
        <h2>Previous Experience</h2>
        <ul>
          {
            homepagePositions.map((pos) => (
              <li class="career-item">
                <OrgLogo logos={pos.logos} fallback="work" />
                <span class="career-body">
                  <span class="line-main">
                    {pos.organizationUrl ? <a href={pos.organizationUrl} target="_blank" rel="noopener">{pos.organization}</a> : pos.organization}
                  </span>
                  <span class="years">{yearRange(pos.dateStart, pos.dateEnd, pos.ongoing)}</span>
                  <span class="line-sub">{pos.title}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </article>
      <article class="career-col">
        <h2>Education</h2>
        <ul>
          {
            homepageEducation.map((edu) => {
              const thesis = edu.thesisPublicationId
                ? publicationsById.get(edu.thesisPublicationId)
                : undefined;
              const thesisUrl = thesis?.data.links.find((link) => link.label === 'Paper')?.url;
              return (
              <li class="career-item">
                <OrgLogo logos={edu.logos} fallback="education" />
                <span class="career-body">
                  <span class="line-main">
                    {edu.institutionUrl ? <a href={edu.institutionUrl} target="_blank" rel="noopener">{edu.institution}</a> : edu.institution}
                  </span>
                  <span class="years">{yearRange(edu.dateStart, edu.dateEnd)}</span>
                  <span class="line-sub">{edu.homepageDegree ?? edu.degree}</span>
                  {
                    thesis && thesisUrl && (
                      <span class="line-thesis">
                        <span class="thesis-label">Thesis:</span>{' '}
                        <a href={thesisUrl}>{thesis.data.title}</a>
                      </span>
                    )
                  }
                </span>
              </li>
              );
            })
          }
        </ul>
      </article>
    </div>
  </section>

  <LandingNews items={news} />

  <Section
    id="research"
    title="Selected publications"
    moreHref={scholarUrl}
    moreLabel={`All publications`}
    layout="stacked"
  >
    <div class="pub-list">
      {
        selectedPubs.map((pub) => <PublicationCard {pub} showcase />)
      }
    </div>
  </Section>

  <Section id="thesis" eyebrow="PhD thesis" hideHeading>
    <PhDBookShowcase />
  </Section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(1.5rem, 3.5vw, 2.75rem);
    border-bottom: 1px solid var(--border);
  }

  .hero-main {
    display: grid;
    grid-template-columns: minmax(15rem, 0.78fr) minmax(0, 1.7fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: start;
  }

  .identity {
    min-width: 0;
  }

  .portrait-frame {
    position: relative;
    width: 13.5rem;
    margin-bottom: 1.5rem;
    border: 1px solid var(--border);
    background: var(--bg-solid);
  }

  .portrait-frame::before,
  .portrait-frame::after {
    content: '';
    position: absolute;
    z-index: 2;
    width: 1.35rem;
    height: 1.35rem;
    pointer-events: none;
  }

  .portrait-frame::before {
    top: -0.5rem;
    left: -0.5rem;
    border-top: 2px solid var(--signal);
    border-left: 2px solid var(--signal);
  }

  .portrait-frame::after {
    right: -0.5rem;
    bottom: -0.5rem;
    border-right: 2px solid var(--accent);
    border-bottom: 2px solid var(--accent);
  }

  .avatar {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.86) contrast(1.02);
  }

  .identity-copy h1 {
    max-width: 13rem;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 2.15rem + 1.5vw, 3.5rem);
    font-weight: 680;
    line-height: 0.9;
    letter-spacing: -0.065em;
  }

  .role {
    margin-top: 0.9rem;
    font-family: var(--font-display);
    font-size: 1.18rem;
    font-style: normal;
    font-weight: 500;
    color: var(--text-muted);
  }

  .affiliation {
    max-width: 20rem;
    margin-top: 0.4rem;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--text-faint);
  }

  .affiliation :global(a) {
    display: inline-flex;
    flex-direction: column;
    gap: 0;
  }

  @media (min-width: 900px) {
    .affiliation :global(.affiliation-primary) {
      white-space: nowrap;
    }
  }

  .social-row {
    margin-top: 1rem;
  }

  .hero-copy {
    align-self: stretch;
    display: flex;
    align-items: center;
    padding-top: 0.15rem;
  }

  .bio {
    max-width: 40rem;
    font-size: var(--font-size-copy);
    color: var(--text-muted);
    line-height: var(--leading-copy);
  }

  .bio :global(p + p) {
    margin-top: 0.9em;
  }

  .bio :global(p) {
    color: inherit;
  }

  .profile-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.2fr 1.2fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .profile-grid h2 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .profile-grid ul {
    list-style: none;
    padding: 0;
    margin-top: 0.8rem;
    border-top: 1px solid var(--border-strong);
  }

  .focus-list li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 3.35rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--border);
    font-size: var(--font-size-copy);
    line-height: 1.45;
  }

  .focus-icon {
    flex: 0 0 auto;
    color: var(--accent);
  }

  .focus-list li > span:last-child {
    color: var(--text-muted);
  }

  .career-col ul {
    display: flex;
    flex-direction: column;
  }

  .career-item {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--border);
  }

  .career-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: 0.7rem;
    min-width: 0;
    flex: 1;
  }

  .line-main {
    min-width: 0;
    font-size: var(--font-size-copy);
    font-weight: 590;
  }

  .line-sub {
    grid-column: 1 / -1;
    font-size: var(--font-size-copy);
    line-height: 1.45;
    color: var(--text-muted);
  }

  .line-thesis {
    grid-column: 1 / -1;
    margin-top: 0.18rem;
    font-size: 0.84rem;
    line-height: 1.4;
    color: var(--text-muted);
  }

  .years {
    max-width: 7.5rem;
    text-align: right;
    color: var(--text-muted);
    font: 0.72rem/1.3 var(--font-sans);
    font-variant-numeric: tabular-nums;
  }

  .pub-list {
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 721px) and (max-width: 1099px) {
    .hero-main {
      grid-template-columns: minmax(19.5rem, 0.8fr) minmax(0, 1.5fr);
      gap: clamp(2rem, 3vw, 2.75rem);
    }

    .social-row :global(.social) {
      flex-wrap: nowrap;
    }
  }

  @media (min-width: 900px) and (max-width: 1099px) {
    .hero-main {
      grid-template-columns: minmax(22.5rem, 0.95fr) minmax(0, 1.2fr);
      gap: 2rem;
    }
  }

  @media (min-width: 1100px) {
    .hero-main {
      grid-template-columns: minmax(23rem, 0.78fr) minmax(0, 1.22fr);
      gap: 0;
      margin-inline: clamp(0rem, calc(50vw - 34rem), 4rem);
    }

    .identity {
      padding-right: clamp(2rem, 3vw, 3.25rem);
    }

    .portrait-frame {
      width: 13.5rem;
    }

    .identity-copy h1 {
      max-width: none;
      white-space: nowrap;
    }

    .role {
      font-size: 1.3rem;
    }

    .affiliation {
      max-width: 22rem;
    }

    .hero-copy {
      min-height: 100%;
      padding: 0 0 0 clamp(2.5rem, 4vw, 4rem);
      border-left: 1px solid var(--border);
    }

    .bio {
      max-width: 40rem;
      line-height: 1.72;
    }

    .bio :global(p + p) {
      margin-top: 1.05em;
    }
  }

  @media (max-width: 720px) {
    .hero {
      padding-block: 1.25rem 1.75rem;
    }

    .hero-main {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }

    .identity {
      display: grid;
      grid-template-columns: minmax(9rem, 13rem) 1fr;
      gap: 1.4rem;
      align-items: end;
    }

    .social-row {
      grid-column: 1 / -1;
    }

    .portrait-frame {
      width: min(100%, 13rem);
      margin-bottom: 0;
    }

    .hero-copy {
      padding-top: 0;
    }

    .profile-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      margin-top: 2.35rem;
    }

    .pub-list > :global(.pub:nth-child(n + 5)) {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .identity {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.9rem;
      align-items: start;
    }

    .identity-copy {
      width: 100%;
      min-width: 0;
      text-align: center;
    }

    .identity-copy h1 {
      max-width: none;
      font-size: clamp(2.5rem, 12.5vw, 3rem);
      line-height: 0.9;
    }

    .affiliation {
      margin-inline: auto;
    }

    .affiliation :global(a) {
      align-items: center;
    }

    .social-row {
      margin-top: -0.15rem;
    }

    .social-row :global(.social) {
      justify-content: center;
    }

    .portrait-frame {
      justify-self: center;
      width: 9.25rem;
    }

    .portrait-frame::before,
    .portrait-frame::after {
      width: 1rem;
      height: 1rem;
    }

    .portrait-frame::before {
      top: -0.35rem;
      left: -0.35rem;
    }

    .portrait-frame::after {
      right: -0.35rem;
      bottom: -0.35rem;
    }

    .role {
      margin-top: 0.65rem;
      font-size: 1rem;
      line-height: 1.25;
    }

    .affiliation {
      margin-top: 0.35rem;
      font-size: 0.86rem;
      line-height: 1.4;
    }

    .bio {
      line-height: 1.62;
    }

    .focus-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 350px) {
    .identity-copy h1 {
      font-size: 2.4rem;
    }

    .portrait-frame {
      width: 8.75rem;
    }

    .role {
      font-size: 0.92rem;
    }

    .affiliation {
      font-size: 0.8rem;
    }
  }
</style>
